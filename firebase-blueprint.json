{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated application user profile with server-enforced role.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoUrl": { "type": "string" },
        "role": { "type": "string", "enum": ["ADMIN", "STAFF", "PUBLIC"] },
        "preferredLanguage": { "type": "string", "enum": ["hi", "en"] },
        "createdAt": { "type": "string", "format": "date-time", "description": "Must be FieldValue.serverTimestamp()" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Must be FieldValue.serverTimestamp()" }
      },
      "required": ["userId", "displayName", "email", "role", "preferredLanguage", "createdAt", "updatedAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Authoritative admin membership document.",

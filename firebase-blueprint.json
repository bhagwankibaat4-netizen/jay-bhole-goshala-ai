  "firestore": {
    "/users/{userId}": { "schema": "UserProfile", "description": "User profiles with server-locked roles" },
    "/admins/{uid}": { "schema": "AdminRecord", "description": "Authorized admin UIDs" },
    "/staffInvites/{emailKey}": { "schema": "StaffInvite", "description": "Admin-issued staff email invites" },
    "/staffAccounts/{uid}": { "schema": "StaffAccount", "description": "Active staff accounts and module permissions" },
    "/goshalaInfo/{docId}": { "schema": "PublicSummary", "description": "Public summary metrics document" },
    "/products/{productId}": { "schema": "GoshalaProduct", "description": "Admin-managed live Goshala products catalog" },
    "/cattle/{cattleId}": { "schema": "Cattle", "description": "Cattle registry" },
    "/cattlePhotos/{cattleId}": { "schema": "CattlePhoto", "description": "Cloud-persisted cow photo fallback linked to cattle/{cattleId}" },
    "/healthRecords/{recordId}": { "schema": "HealthRecord", "description": "Health, vaccination, and treatment logs" },
    "/feedAndOperations/{logId}": { "schema": "FeedAndOperationLog", "description": "Daily feed, water, cleaning, and task logs" },
    "/staffOperations/{entryId}": { "schema": "StaffOperation", "description": "Staff attendance, salary, and tasks" },
    "/financialTransactions/{txId}": { "schema": "FinancialTransaction", "description": "Goshala income and expense ledger" },
    "/farmers/{farmerId}": { "schema": "FarmerRecord", "description": "Local farmer supplier/buyer directory" },
    "/farmerTransactions/{txId}": { "schema": "FarmerTransaction", "description": "Farmer purchase/sale invoices" },
    "/compostProduction/{batchId}": { "schema": "CompostBatch", "description": "Gobar and compost production batches" },
    "/donations/{donationId}": { "schema": "Donation", "description": "Donation records and receipts" },
    "/sponsorships/{sponsorshipId}": { "schema": "Sponsorship", "description": "Cow sponsorship applications and certificates" },
    "/productOrders/{orderId}": { "schema": "ProductOrder", "description": "Public product purchase applications managed by Admin" },
    "/notifications/{notifId}": { "schema": "NotificationItem", "description": "Goshala alerts and reminders" },

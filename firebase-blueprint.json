      "required": ["animalCode", "name", "category", "breed", "sex", "ageText", "colour", "weightKg", "healthStatus", "entryDate", "shedNumber", "identificationMarks", "qrPayload", "publicApproved", "sponsorshipAvailable", "monthlySupportInr", "createdBy", "createdAt", "updatedAt"]
    },
